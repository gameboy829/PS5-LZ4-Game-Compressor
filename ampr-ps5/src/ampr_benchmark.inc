  auto report=benchmarkState["report"];report["valid"]=false;try{auto temporary=benchmarkReportPath();temporary+=".tmp";{std::ofstream file(temporary);file<<report.dump(2);file.flush();check(bool(file),"Cannot invalidate benchmark report");}fs::rename(temporary,benchmarkReportPath());}catch(...){std::error_code ec;fs::remove(benchmarkReportPath(),ec);}
