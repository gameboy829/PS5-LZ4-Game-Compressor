static void benchmarkCheckSource(const BenchmarkRange&r){check(fs::file_size(r.source)==r.originalSize&&fs::last_write_time(r.source)==r.mtime,"Benchmark source changed: "+r.relative);}
static std::vector<StageThreads> benchmarkCandidates(const std::string&stage,StageThreads current,bool exhaustive=false){
 std::vector<StageThreads> c;
 if(stage=="packing")c={{1,1,1},{1,2,1},{2,2,1},{1,3,1},{2,2,2},{2,3,2},{2,4,1},{3,2,2},{1,4,2}};
 else if(stage=="loose")c={{1,0,1},{2,0,1},{1,0,2},{2,0,2},{3,0,2},{2,0,3},{3,0,3},{3,0,4},{4,0,3}};
 else c={{1,1,0},{1,2,0},{2,2,0},{2,3,0},{3,3,0},{2,4,0},{3,4,0},{4,3,0},{2,5,0}};
 if(exhaustive){c.clear();for(unsigned readers=1;readers<=6;readers++)for(unsigned other=1;readers+other<=7;other++){if(stage=="packing"){for(unsigned writers=1;readers+other+writers<=7;writers++)c.push_back({readers,other,writers});}else c.push_back({readers,stage=="verification"?other:0,stage=="loose"?other:0});}}
 if(std::none_of(c.begin(),c.end(),[&](StageThreads s){return s.readers==current.readers&&s.workers==current.workers&&s.writers==current.writers;}))c.push_back(current);
